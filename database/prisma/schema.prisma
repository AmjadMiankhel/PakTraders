model BlogCategory {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())

  posts BlogPost[]

  @@map("blog_categories")
}

model BlogTag {
  id   String @id @default(uuid()) @db.Uuid
  name String
  slug String @unique

  posts BlogPostTag[]

  @@map("blog_tags")
}

model BlogPost {
  id              String        @id @default(uuid()) @db.Uuid
  slug            String        @unique
  title           String
  excerpt         String?
  content         String
  coverImage      String?
  categoryId      String?       @db.Uuid
  authorId        String?       @db.Uuid
  status          ContentStatus @default(DRAFT)
  publishedAt     DateTime?
  readingMinutes  Int           @default(5)
  seoTitle        String?
  metaDescription String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  category BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author   User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  tags     BlogPostTag[]

  @@index([status, publishedAt])
  @@map("blog_posts")
}

model BlogPostTag {
  postId String @db.Uuid
  tagId  String @db.Uuid

  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@map("blog_post_tags")
}

model Page {
  id              String        @id @default(uuid()) @db.Uuid
  slug            String        @unique
  title           String
  content         String
  template        String        @default("standard")
  status          ContentStatus @default(DRAFT)
  seoTitle        String?
  metaDescription String?
  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("pages")
}

model Advertisement {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  placement String
  imageUrl  String?
  html      String?
  targetUrl String?
  startsAt  DateTime?
  endsAt    DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())

  @@map("advertisements")
}

model Testimonial {
  id         String   @id @default(uuid()) @db.Uuid
  authorName String
  company    String?
  quote      String
  avatarUrl  String?
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@map("testimonials")
}

model SeoMetadata {
  id             String   @id @default(uuid()) @db.Uuid
  path           String   @unique
  title          String?
  description    String?
  canonical      String?
  robots         String?
  ogImage        String?
  structuredData Json?
  updatedAt      DateTime @updatedAt

  @@map("seo_metadata")
}

model Redirect {
  id         String   @id @default(uuid()) @db.Uuid
  fromPath   String   @unique
  toPath     String
  statusCode Int      @default(301)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@map("redirects")
}

// ---------------------------------------------------------------------------
// Mobile
// ---------------------------------------------------------------------------

model Device {
  id         String      @id @default(uuid()) @db.Uuid
  userId     String?     @db.Uuid
  platform   AppPlatform
  deviceId   String?
  model      String?
  osVersion  String?
  appVersion String?
  lastSeenAt DateTime    @default(now())
  createdAt  DateTime    @default(now())

  user       User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  pushTokens PushToken[]

  @@unique([deviceId])
  @@index([userId])
  @@map("devices")
}

model PushToken {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @db.Uuid
  deviceId  String?     @db.Uuid
  token     String      @unique
  platform  AppPlatform
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("push_tokens")
}

model AppConfiguration {
  id              String      @id @default(uuid()) @db.Uuid
  platform        AppPlatform @unique
  appName         String      @default("Pak Tenders")
  logoUrl         String?
  splashUrl       String?
  welcomeMessage  String?
  maintenanceMode Boolean     @default(false)
  minVersion      String?
  latestVersion   String?
  forceUpdate     Boolean     @default(false)
  featuresJson    Json?
  storeUrl        String?
  privacyUrl      String?
  termsUrl        String?
  supportUrl      String?
  updatedAt       DateTime    @updatedAt

  @@map("app_configurations")
}

model AppAnnouncement {
  id        String      @id @default(uuid()) @db.Uuid
  platform  AppPlatform
  title     String
  body      String
  imageUrl  String?
  startsAt  DateTime?
  endsAt    DateTime?
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())

  @@index([platform, isActive])
  @@map("app_announcements")
}

// ---------------------------------------------------------------------------
// Administration
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  actorEmail String?
  action     String
  entityType String
  entityId   String?
  beforeJson Json?
  afterJson  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model SystemSetting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  valueJson   Json
  description String?
  isPublic    Boolean  @default(false)
  updatedById String?  @db.Uuid
  updatedAt   DateTime @updatedAt

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("system_settings")
}

model Integration {
  id            String            @id @default(uuid()) @db.Uuid
  key           String            @unique
  name          String
  category      String
  status        IntegrationStatus @default(NOT_CONFIGURED)
  configJson    Json?
  lastCheckedAt DateTime?
  lastError     String?
  updatedAt     DateTime          @updatedAt

  @@map("integrations")
}

model ImportJob {
  id            String    @id @default(uuid()) @db.Uuid
  type          String
  fileName      String?
  status        JobStatus @default(QUEUED)
  totalRows     Int       @default(0)
  processedRows Int       @default(0)
  failedRows    Int       @default(0)
  errorsJson    Json?
  createdById   String?   @db.Uuid
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime  @default(now())

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@map("import_jobs")
}

model ProcessingJob {
  id          String    @id @default(uuid()) @db.Uuid
  type        String
  payloadJson Json?
  status      JobStatus @default(QUEUED)
  attempts    Int       @default(0)
  lastError   String?
  scheduledAt DateTime  @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, scheduledAt])
  @@map("processing_jobs")
}

model ErrorLog {
  id        String   @id @default(uuid()) @db.Uuid
  level     LogLevel @default(ERROR)
  message   String
  stack     String?
  context   Json?
  requestId String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([level])
  @@map("error_logs")
}

// ---------------------------------------------------------------------------
// Automated tender collection & monitoring
// ---------------------------------------------------------------------------

model SourceRun {
  id               String           @id @default(uuid()) @db.Uuid
  sourceId         String           @db.Uuid
  jobId            String?
  status           SourceRunStatus  @default(QUEUED)
  trigger          SourceRunTrigger @default(SCHEDULE)
  startedAt        DateTime         @default(now())
  finishedAt       DateTime?
  durationMs       Int?
  itemsFound       Int              @default(0)
  itemsNew         Int              @default(0)
  itemsUpdated     Int              @default(0)
  itemsDuplicate   Int              @default(0)
  itemsUnchanged   Int              @default(0)
  itemsReview      Int              @default(0)
  itemsFailed      Int              @default(0)
  documentsFetched Int              @default(0)
  bytesDownloaded  Int              @default(0)
  errorSummary     String?          @db.Text
  logJson          Json?
  createdAt        DateTime         @default(now())

  source    TenderSource     @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  imports   TenderImport[]
  documents SourceDocument[]

  @@index([sourceId, startedAt])
  @@index([status, startedAt])
  @@map("source_runs")
}

model SourceDocument {
  id                   String    @id @default(uuid()) @db.Uuid
  sourceId             String    @db.Uuid
  runId                String?   @db.Uuid
  tenderId             String?   @db.Uuid
  url                  String    @db.Text
  finalUrl             String?   @db.Text
  fileName             String?
  mimeType             String?
  httpStatus           Int?
  contentLength        Int?
  sha256               String?
  storagePath          String?
  fetchedAt            DateTime  @default(now())
  textContent          String?   @db.Text
  textLanguage         String?
  pageCount            Int?
  ocrStatus            OcrStatus @default(NOT_REQUIRED)
  ocrConfidence        Float?
  extractionConfidence Float?
  error                String?   @db.Text

  source     TenderSource       @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  run        SourceRun?         @relation(fields: [runId], references: [id], onDelete: SetNull)
  tender     Tender?            @relation(fields: [tenderId], references: [id], onDelete: SetNull)
  imports    TenderImport[]
  provenance TenderProvenance[]

  @@index([sourceId, fetchedAt])
  @@index([sha256])
  @@index([tenderId])
  @@map("source_documents")
}

model TenderImport {
  id               String       @id @default(uuid()) @db.Uuid
  sourceKey        String       @unique
  sourceId         String       @db.Uuid
  runId            String?      @db.Uuid
  externalId       String?
  sourceUrl        String       @db.Text
  title            String
  rawJson          Json
  rawHash          String?
  normalizedJson   Json?
  status           IngestStatus @default(NEW)
  confidence       Float?
  changeCount      Int          @default(0)
  lastSeenAt       DateTime     @default(now())
  tenderId         String?      @db.Uuid
  duplicateOfId    String?      @db.Uuid
  duplicateScore   Float?
  duplicateSignals Json?
  reviewNotes      String?      @db.Text
  documentId       String?      @db.Uuid
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  source   TenderSource            @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  run      SourceRun?              @relation(fields: [runId], references: [id], onDelete: SetNull)
  tender   Tender?                 @relation(fields: [tenderId], references: [id], onDelete: SetNull)
  document SourceDocument?         @relation(fields: [documentId], references: [id], onDelete: SetNull)
  reviews  TenderDuplicateReview[]

  @@index([status, createdAt])
  @@index([sourceId, externalId])
  @@index([tenderId])
  @@map("tender_imports")
}

model TenderProvenance {
  id         String                @id @default(uuid()) @db.Uuid
  tenderId   String                @db.Uuid
  field      String
  value      String?               @db.Text
  source     ExtractionFieldSource @default(SOURCE)
  confidence Float?
  documentId String?               @db.Uuid
  page       Int?
  note       String?
  createdAt  DateTime              @default(now())

  tender   Tender          @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  document SourceDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([tenderId, field])
  @@map("tender_provenance")
}

model TenderDuplicateReview {
  id             String             @id @default(uuid()) @db.Uuid
  tenderId       String             @db.Uuid
  candidateId    String?            @db.Uuid
  importId       String?            @db.Uuid
  matchType      DuplicateMatchType
  score          Float
  signalsJson    Json?
  decision       DuplicateDecision  @default(PENDING)
  mergedTenderId String?            @db.Uuid
  reviewedById   String?            @db.Uuid
  reviewedAt     DateTime?
  createdAt      DateTime           @default(now())

  tender     Tender        @relation("DuplicatePrimary", fields: [tenderId], references: [id], onDelete: Cascade)
  candidate  Tender?       @relation("DuplicateCandidate", fields: [candidateId], references: [id], onDelete: SetNull)
  import     TenderImport? @relation(fields: [importId], references: [id], onDelete: SetNull)
  reviewedBy User?         @relation("DuplicateReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([decision, createdAt])
  @@index([tenderId])
  @@map("tender_duplicate_reviews")
}
