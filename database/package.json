{
  "name": "@paktenders/database",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma schema, migrations, seed and the shared PrismaClient instance",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "generate": "prisma generate",
    "migrate": "dotenv run -f ../.env -- prisma migrate dev",
    "migrate:deploy": "dotenv run -f ../.env -- prisma migrate deploy",
    "push": "dotenv run -f ../.env -- prisma db push",
    "seed": "dotenv run -f ../.env -- tsx prisma/seed.ts",
    "purge:demo": "dotenv run -f ../.env -- tsx prisma/purge-demo.ts",
    "studio": "dotenv run -f ../.env -- prisma studio",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "argon2": "0.45.2",
    "dotenv": "18.0.10"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "dotenv-cli": "11.0.0",
    "prisma": "6.19.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
