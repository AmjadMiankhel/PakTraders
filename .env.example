# ─────────────────────────────────────────────────────────────────────────────
# Pak Tenders — environment template
# Copy to .env at the repository root and fill in real values.
# NEVER commit .env. Values marked REQUIRED must be set before starting.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development

# ── Database (REQUIRED) ──────────────────────────────────────────────────────
# PostgreSQL 15+. sslmode=disable for local development only.
DATABASE_URL="postgresql://paktenders:paktenders@localhost:5432/paktenders?schema=public"

# ── API ──────────────────────────────────────────────────────────────────────
API_PORT=4000
API_PUBLIC_URL="http://localhost:4000"
# Comma-separated list of allowed browser origins
CORS_ORIGINS="http://localhost:3000"
# Optional shared secret for server-to-server calls from the website. When set,
# the web server sends it on SSR fetches so its requests are not counted against
# the per-IP public rate limit. Generate a random value for production.
INTERNAL_API_KEY=""
# REQUIRED in production: random string >= 32 chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="dev-only-change-me-access-secret-0123456789abcdef"
JWT_REFRESH_SECRET="dev-only-change-me-refresh-secret-0123456789abcdef"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=30

# ── Web ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000"
# Server-side URL used by Next.js server components / route handlers
API_INTERNAL_URL="http://localhost:4000"
# Canonical production origin (used for sitemaps/canonicals)
SITE_URL="http://localhost:3000"

# ── Redis / BullMQ (optional; scheduled collection needs Redis) ──────────────
REDIS_URL=""
# Automated tender collection (requires Redis for background jobs)
COLLECTION_ENABLED=true
COLLECTION_WORKER_ENABLED=true
COLLECTION_CONCURRENCY=4
COLLECTION_USER_AGENT="PakTendersBot/1.0 (+https://paktenders.pk/bot)"
COLLECTION_HTTP_TIMEOUT_MS=30000
COLLECTION_MAX_DOCUMENT_MB=25
COLLECTION_MAX_ITEMS_PER_RUN=100
COLLECTION_DEADLINE_CRON="0 2 * * *"
COLLECTION_RECONCILE_CRON="30 2 * * *"
OCR_ENABLED=true
OCR_LANGUAGES="eng,urd"
AI_COLLECTION_ENABLED=true
BULLMQ_PREFIX="paktenders"
# IMAP tender feed (only when an authorised mailbox is available)
COLLECTION_EMAIL_HOST=""
COLLECTION_EMAIL_USER=""
COLLECTION_EMAIL_PASSWORD=""

# ── Email (optional until configured in Admin → Integrations) ────────────────
EMAIL_PROVIDER=""          # resend | ses | smtp
EMAIL_FROM="no-reply@paktenders.pk"
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""

# ── File storage (S3-compatible, optional until configured) ──────────────────
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# ── AI / Chatbot (optional; chatbot runs in safe disabled mode without it) ───
AI_PROVIDER=""             # openai | anthropic | google | openrouter | local
AI_MODEL=""
AI_API_KEY=""
AI_BASE_URL=""
CHATBOT_ENABLED=false

# ── Payments (optional until credentials + approval) ─────────────────────────
JAZZCASH_MERCHANT_ID=""
JAZZCASH_PASSWORD=""
JAZZCASH_INTEGRITY_SALT=""
EASYPAISA_STORE_ID=""
EASYPAISA_HASH_KEY=""
CARD_GATEWAY_KEY=""
CARD_GATEWAY_SECRET=""

# ── Push notifications (optional until configured) ───────────────────────────
EXPO_ACCESS_TOKEN=""
FCM_SERVER_KEY=""
APNS_KEY_ID=""
APNS_TEAM_ID=""
APNS_PRIVATE_KEY=""

# ── Analytics (optional) ─────────────────────────────────────────────────────
NEXT_PUBLIC_GA4_ID=""
NEXT_PUBLIC_GTM_ID=""
GOOGLE_SITE_VERIFICATION=""
BING_SITE_VERIFICATION=""

# ── Seed / bootstrap admin ───────────────────────────────────────────────────
SEED_ADMIN_EMAIL="admin@paktenders.pk"
SEED_ADMIN_PASSWORD="ChangeMe!PakTenders2026"
SEED_DEMO_DATA=true        # demo tenders are always flagged isDemo + DEMO verification
